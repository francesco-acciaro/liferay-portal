{
	"concurrencyPolicy": "Forbid",
	"cpu": 2,
	"env": {
		"GRADLE_OPTS": "-Dorg.gradle.daemon=false",
		"JAVA_VERSION": "zulu21",
		"LIFERAY_JAR_RUNNER_JAVA_OPTS": "-Xmx2048m",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_DXP_SITE_FRIENDLY_URL_PATH": "guest",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_DXP_URL": "https://learn-dev.liferay.com",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_GITHUB_BRANCH": "learn-cron-importer",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_GITHUB_DEPLOY_KEY": "@learn-fork-deploy-key",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_GITHUB_USER": "francesco-acciaro",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_GIT_REPOSITORY_DIR": "/home/liferay/liferay-learn",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_OAUTH_CLIENT_ID": "@learn-importer-oauth-client-id",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_OAUTH_CLIENT_SECRET": "@learn-importer-oauth-client-secret",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_ORPHAN_CLEANUP": "true",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_PARTIAL": "false",
		"LIFERAY_LEARN_ETC_CRON_IMPORTER_SKIP_LOCALES_CONTENT": "ja,ko",
		"LIFERAY_LEARN_ETC_CRON_SKIP_UPDATE_EXAMPLES": "true",
		"LIFERAY_LEARN_RESOURCE_DOMAIN": "https://resources.learn-dev.liferay.com",
		"LIFERAY_LEARN_UPDATE_EXAMPLES_JOBS": "4"
	},
	"environments": {
		"extprd": {
			"deploy": false
		},
		"extuat": {
			"deploy": false
		},
		"infra": {
			"deploy": false
		}
	},
	"id": "__PROJECT_ID__",
	"kind": "CronJob",
	"memory": 3000,
	"scale": 1,
	"schedule": "49 13 * * *",
	"volumes": {
		"publicHtml": "/public_html"
	}
}