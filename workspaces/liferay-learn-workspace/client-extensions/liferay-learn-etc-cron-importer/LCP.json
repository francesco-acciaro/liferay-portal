{
	"concurrencyPolicy": "Forbid",
	"cpu": 2,
	"env": {
		"JAVA_VERSION": "zulu21",
		"LIFERAY_LEARN_ETC_CRON_GITHUB_BRANCH": "learn-cron-importer",
		"LIFERAY_LEARN_ETC_CRON_GITHUB_DEPLOY_KEY": "@learn-fork-deploy-key",
		"LIFERAY_LEARN_ETC_CRON_GITHUB_USER": "francesco-acciaro",
		"LIFERAY_LEARN_ETC_CRON_GIT_REPOSITORY_DIR": "/home/liferay/liferay-learn",
		"LIFERAY_LEARN_RESOURCE_DOMAIN": "https://resources.learn-dev.liferay.com",
		"LIFERAY_LEARN_UPDATE_EXAMPLES_JOBS": "4"
	},
	"environments": {
		"extprd": {
			"deploy": false
		},
		"extuat": {
			"deploy": false
		},
		"infra": {
			"deploy": false
		}
	},
	"id": "__PROJECT_ID__",
	"kind": "CronJob",
	"memory": 3000,
	"scale": 1,
	"schedule": "8 13 * * *",
	"volumes": {
		"publicHtml": "/public_html"
	}
}